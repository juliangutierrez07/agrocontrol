APP_ENV=local
APP_DEBUG=false
# URL pública usada para construir enlaces de recuperación de contraseña.
# En producción debe usar HTTPS, por ejemplo: https://agrocontrol.tudominio.com
APP_URL=http://localhost/AgroControl
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=agrocontrol
DB_CHARSET=utf8mb4

# Remitente para los correos de recuperación.
MAIL_FROM=no-reply@agrocontrol.local
MAIL_FROM_NAME=AgroControl

# Correo SMTP para producción. Ejemplo: Brevo, Mailgun o correo del hosting.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=usuario_smtp
SMTP_PASS=contraseña_o_clave_de_aplicacion

# Rate limiting para el formulario de login
# Número máximo de intentos fallidos antes del bloqueo
LOGIN_MAX_ATTEMPTS=5
# Duración del bloqueo en segundos (900 = 15 minutos)
LOGIN_LOCKOUT_SECS=900
